<icecast>
    <location>FM Radio</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>200</clients>
        <sources>64</sources>
        <queue-size>524288</queue-size>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65536</burst-size>
    </limits>

    <authentication>
        <source-password>${ICECAST_SOURCE}</source-password>
        <relay-password>${ICECAST_SOURCE}</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>${ICECAST_ADMIN_PASS}</admin-password>
    </authentication>

    <!-- Advertised in stream URLs on the status page; set ICECAST_HOSTNAME
         to this machine's LAN name/IP so those links work for listeners. -->
    <hostname>${ICECAST_HOSTNAME}</hostname>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <logdir>/var/log/icecast2</logdir>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <listen-socket>
        <port>${ICECAST_PORT}</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>

    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <logging>
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>3</loglevel>
    </logging>

    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>nobody</user>
            <group>nogroup</group>
        </changeowner>
    </security>
</icecast>
