# RTL DAB Player — Docker environment example
# Copy this file to .env and adjust the values, then run:
#   docker compose --env-file .env up
#
# Alternatively, set these directly under 'environment:' in docker-compose.yml.
#
# NOTE: .env files do NOT support inline comments (e.g. VALUE=foo # comment).
#       Put comments on their own separate lines only.

# ── Icecast mode ─────────────────────────────────────────────────────────────
# 'internal'  — Icecast runs inside this container (default)
# 'external'  — stream to an existing Icecast server on your network
ICECAST_MODE=internal

# ── Icecast credentials ───────────────────────────────────────────────────────
# CHANGE THESE. Icecast is reachable from your whole LAN, including its /admin
# interface, and the daemon warns on startup while the defaults are in use.
# ICECAST_SOURCE is the source password (used to publish streams — needed in
# BOTH modes). ICECAST_ADMIN_PASS secures /admin and is the fallback used for
# metadata updates.
ICECAST_SOURCE=changeme
ICECAST_ADMIN_PASS=changeme_admin

# Hostname/IP this machine is reachable at, advertised in the stream URLs on
# Icecast's status page. Defaults to the container IP. (Internal mode only.)
# ICECAST_HOSTNAME=192.168.1.50

# ── External mode ─────────────────────────────────────────────────────────────
# Set ICECAST_MODE=external and fill in ICECAST_HOST to use an existing server.
# ICECAST_MODE=external
# ICECAST_HOST=192.168.1.50

# ── Shared Icecast settings ───────────────────────────────────────────────────
ICECAST_PORT=8000
ICECAST_MOUNT=/dab

# ── Daemon ────────────────────────────────────────────────────────────────────
DAEMON_PORT=9980

# How long to wait for welle-cli to discover the stations on a mux, in seconds.
DISCOVERY_TIMEOUT=30

# How long /listen holds a browser connection waiting for a station's stream to
# come up (e.g. during a mux switch) before giving up, in seconds.
LISTEN_WAIT_TIMEOUT=90

# ── MUX list (optional JSON override) ────────────────────────────────────────
# Override the built-in MUX list with a JSON array. Example:
# MUX_LIST=[{"key":"mux1","name":"DR MUX (11C)","channel":"11C"},{"key":"mux2","name":"MUX 2","channel":"10B"}]

# ── Logging ──────────────────────────────────────────────────────────────────
# Directory inside the container where log files are written.
# Map a volume in docker-compose.yml to access logs from the host, e.g.:
#   volumes:
#     - ./logs:/var/log/dabservice
LOG_DIR=/var/log/dabservice

# Maximum size per log file before rotation (in bytes). Default: 10485760 (10 MB)
LOG_MAX_BYTES=10485760

# Number of backup log files to keep. Default: 3
LOG_BACKUP_COUNT=3

# ── Signal quality monitoring ───────────────────────────────────────────────
# SNR (Signal-to-Noise Ratio) threshold in dB. A warning is logged when SNR
# drops below this value. Default: 10
SNR_WARNING_THRESHOLD=10

# ── Preventive welle-cli restart ────────────────────────────────────────────
# Hour of day (0-23, local container time) to perform a graceful restart of
# welle-cli and all ffmpeg streams. This clears accumulated file descriptor
# leaks in welle-cli. Set to any value outside 0-23 (e.g. -1) to disable.
# Default: 3 (03:00 AM)
PREVENTIVE_RESTART_HOUR=3
